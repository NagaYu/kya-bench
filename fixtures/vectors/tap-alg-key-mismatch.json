{
  "id": "tap-alg-key-mismatch",
  "protocol": "tap",
  "kind": "bundle",
  "category": "registry",
  "description": "alg rsa-pss-sha256 declared for a registered Ed25519 key",
  "spec_ref": "RFC 9421 \u00a73.3.7; REPO algorithm per key",
  "strictness": "strict",
  "now": 1790000000,
  "bundle": {
    "requests": [
      {
        "method": "GET",
        "authority": "merchant.example",
        "path": "/products/1",
        "headers": {
          "signature-input": "sig2=(\"@authority\" \"@path\");created=1789999970;expires=1790000450;keyid=\"primary-ed25519\";alg=\"rsa-pss-sha256\";nonce=\"a5e3f0d2-6c1b-4e8a-9f7d-2b4c6e8a0f13\";tag=\"agent-browser-auth\"",
          "signature": "sig2=::"
        },
        "operation": "browse"
      }
    ]
  },
  "expected_verdict": "reject",
  "expected_reason_codes": [
    "TAP_ALG_KEY_MISMATCH"
  ]
}
